<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Revit adapters: collection, parameter identity/editability, units, document identity, schedules,
    links, apply engine and the ExternalEvent dispatcher. No WPF here.
    Build per Revit year: -p:RevitVersion=2024|2025|2026
    RevitAPI.dll / RevitAPIUI.dll come from the local Revit installation (Private=false, never copied).
    Override the folder with -p:RevitApiDir="D:\Autodesk\Revit 2026".
  -->
  <PropertyGroup>
    <TargetFramework>$(RevitTargetFramework)</TargetFramework>
    <RootNamespace>CausaFix.Revit</RootNamespace>
    <AssemblyName>CausaFix.Revit</AssemblyName>
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">$(ProgramW6432)\Autodesk\Revit $(RevitVersion)</RevitApiDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CausaFix.Core\CausaFix.Core.csproj" SetTargetFramework="TargetFramework=$(CoreTargetFramework)" />
  </ItemGroup>

  <!-- Real Revit API (normal builds) -->
  <ItemGroup Condition="'$(UseRevitStubs)' != 'true' and '$(UseRevitNuGet)' != 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Compile-check only (CI without Revit). Never shipped. See tools/RevitApiStubs. -->
  <ItemGroup Condition="'$(UseRevitStubs)' == 'true'">
    <ProjectReference Include="..\..\tools\RevitApiStubs\RevitApiStubs.csproj" Private="false" SetTargetFramework="TargetFramework=$(CoreTargetFramework)" />
  </ItemGroup>

  <!-- Optional: reference assemblies from NuGet when Revit is not installed on the build machine (not verified in this delivery). -->
  <ItemGroup Condition="'$(UseRevitNuGet)' == 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CheckRevitApi" BeforeTargets="ResolveAssemblyReferences" Condition="'$(UseRevitStubs)' != 'true' and '$(UseRevitNuGet)' != 'true' and !Exists('$(RevitApiDir)\RevitAPI.dll')">
    <Error Text="RevitAPI.dll not found in '$(RevitApiDir)'. Install Revit $(RevitVersion) or pass -p:RevitApiDir=&quot;folder containing RevitAPI.dll&quot;." />
  </Target>
</Project>
