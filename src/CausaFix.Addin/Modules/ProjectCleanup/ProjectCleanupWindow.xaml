<Window x:Class="CausaFix.Addin.Modules.ProjectCleanup.ProjectCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="CausaFixIt · Project Cleanup" Icon="/CausaFix.Addin;component/Assets/causafixit-32.png"
        Width="1080" Height="740" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="12" Background="#F7F9FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CausaFix.Addin;component/Shared/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Slate}" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/CausaFix.Addin;component/Assets/causafixit-64.png" Width="28" Height="28" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" AutomationProperties.Name="CausaFixIt logo" />
                    <TextBlock Text="CausaFixIt" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="Project Cleanup" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DocumentTitle}" Foreground="#B9C6D1" Margin="18,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="Eliminar documentación conservando la vista activa" Foreground="#B9C6D1" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Kept view and counts -->
        <StackPanel Grid.Row="1" Margin="12,10,12,4">
            <Border Background="#E8F3EA" BorderBrush="#7DB58A" BorderThickness="1" CornerRadius="3" Padding="10,6">
                <TextBlock Text="{Binding KeptView}" FontSize="15" FontWeight="SemiBold" Foreground="#1E4D2B" TextWrapping="Wrap" AutomationProperties.Name="Vista conservada" />
            </Border>
            <!-- Optional extras: off by default; each change rebuilds the review (nothing is deleted until the button). -->
            <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="Borrar también:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox IsChecked="{Binding DeleteCad}" Margin="0,0,16,0" VerticalAlignment="Center"
                          ToolTip="CAD vinculados e importados (CADLinkType con todas sus instancias). Los archivos DWG/DGN no se tocan.">
                    <TextBlock><Run Text="CAD (vinculados e importados) " /><Run Text="{Binding CadAvailable, Mode=OneWay}" Foreground="#6B7680" /></TextBlock>
                </CheckBox>
                <CheckBox IsChecked="{Binding DeleteRevitLinks}" Margin="0,0,16,0" VerticalAlignment="Center"
                          ToolTip="Quita los vínculos de Revit (RevitLinkType con sus instancias y vínculos anidados). Los archivos .rvt no se tocan.">
                    <TextBlock><Run Text="Vínculos de Revit " /><Run Text="{Binding LinksAvailable, Mode=OneWay}" Foreground="#6B7680" /></TextBlock>
                </CheckBox>
                <CheckBox IsChecked="{Binding DeleteImages}" VerticalAlignment="Center"
                          ToolTip="Imágenes raster (ImageType con todas sus instancias en vistas y planos).">
                    <TextBlock><Run Text="Imágenes " /><Run Text="{Binding ImagesAvailable, Mode=OneWay}" Foreground="#6B7680" /></TextBlock>
                </CheckBox>
            </WrapPanel>
            <TextBlock Text="{Binding CountsText}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding BlockedReason}" Foreground="#B00020" FontWeight="SemiBold" TextWrapping="Wrap"
                       Visibility="{Binding BlockedReason, Converter={StaticResource TextToVis}}" />
            <Border Background="#FFF2CC" BorderBrush="#E0A800" BorderThickness="1" Padding="8,4" Margin="0,6,0,0"
                    Visibility="{Binding StaleNotice, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="El documento o la vista activa cambiaron: este es el análisis actualizado. Revísalo y confirma de nuevo." TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Review / result -->
        <Grid Grid.Row="2" Margin="12,4,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Mostrar" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="170" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="T" Text="Todo" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="ToDelete"><Setter TargetName="T" Property="Text" Value="Se eliminan" /></DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="Preserved"><Setter TargetName="T" Property="Text" Value="Se conservan" /></DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="NotDocumentation"><Setter TargetName="T" Property="Text" Value="Sistema (no se tocan)" /></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <TabControl>
                    <TabItem Header="Revisión">
                        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E3E7EA" RowHeight="24" CanUserAddRows="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDelete}" Value="False"><Setter Property="Background" Value="#EEF6F0" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Acción" Binding="{Binding Action}" Width="150" />
                                <DataGridTextColumn Header="Clase" Binding="{Binding Kind}" Width="90" />
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="150" />
                                <DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="70" />
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="220" />
                                <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Resultado" IsEnabled="{Binding HasResult}" IsSelected="{Binding HasResult, Mode=OneWay}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding ResultSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding ResultRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E3E7EA" RowHeight="24" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Resultado" Binding="{Binding Action}" Width="170" />
                                    <DataGridTextColumn Header="Clase" Binding="{Binding Kind}" Width="90" />
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="150" />
                                    <DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="70" />
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="220" />
                                    <DataGridTextColumn Header="Mensaje" Binding="{Binding Reason}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Consecuencias previstas" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Consequences}" Margin="0,2,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Notas" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Notes}" Margin="0,2,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="No se ejecuta Purge Unused ni se borran niveles, ejes, elementos del modelo, familias, paneles, circuitos ni materiales. CAD, vínculos de Revit e imágenes solo se eliminan si marcas su opción (sus archivos externos nunca se tocan); los que tienen una instancia en la vista activa o en una vista conservada se mantienen. Las plantillas de vista y de panel schedule se conservan. El borrado es atómico y queda como un solo Deshacer; el modelo no se guarda ni se sincroniza." />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding BusyText}" Foreground="{StaticResource Muted}" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Buttons -->
        <DockPanel Grid.Row="4" Margin="12,6,12,10">
            <Button DockPanel.Dock="Left" Content="Abrir informe" Command="{Binding OpenReportCommand}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Actualizar análisis" Command="{Binding RefreshCommand}" ToolTip="Vuelve a leer el documento y la vista activa (no cambia nada)" />
                <Button x:Name="DeleteButton" Content="{Binding DeleteButtonText}" Command="{Binding DeleteCommand}" Style="{StaticResource Primary}" Background="#B03A2E" BorderBrush="#B03A2E"
                        ToolTip="Confirmación final: elimina exactamente el alcance mostrado, en una sola operación (un Deshacer)" />
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" ToolTip="Cierra sin cambiar nada" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
