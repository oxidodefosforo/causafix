<Window x:Class="CausaFix.Addin.Modules.Keynotes.KeynoteManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CausaFix.Keynotes.ViewModels;assembly=CausaFix.Keynotes"
        x:Name="Root"
        Title="CausaFixIt · Keynote Manager" Icon="/CausaFix.Addin;component/Assets/causafixit-32.png"
        Width="1220" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="12" Background="#F7F9FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CausaFix.Addin;component/Shared/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Rows fill the whole width so a click on the text or on the free space selects the row. -->
            <Style x:Key="KeynoteItem" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Key}" />
                <EventSetter Event="GotKeyboardFocus" Handler="OnRowFocus" />
                <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
            </Style>
            <Style x:Key="Tool" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Padding" Value="8,2" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Slate}" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/CausaFix.Addin;component/Assets/causafixit-64.png" Width="28" Height="28" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" AutomationProperties.Name="CausaFixIt logo" />
                    <TextBlock Text="CausaFixIt" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="Keynote Manager" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Table.DocumentTitle}" Foreground="#B9C6D1" Margin="18,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DirtyText}" Foreground="#F2B53A" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- File / Revit state -->
        <StackPanel Grid.Row="1" Margin="12,8,12,2">
            <WrapPanel>
                <Button Style="{StaticResource Tool}" Content="New file…" Command="{Binding NewFileCommand}" ToolTip="Creates an empty library (UTF-16 LE) and offers to link it to the model" />
                <Button Style="{StaticResource Tool}" Content="Open…" Command="{Binding OpenFileCommand}" ToolTip="Opens another keynote file (TXT)" />
                <Button Style="{StaticResource Tool}" Content="Link to model" Command="{Binding LinkCommand}" ToolTip="Makes Revit use this file as its keynote table (LoadFrom)" />
                <Button Style="{StaticResource Tool}" Content="Save" Command="{Binding SaveCommand}" ToolTip="Writes the file safely (backup, check for external changes). Revit is not reloaded." />
                <Button Style="{StaticResource Primary}" Margin="0,0,4,4" Content="Save &amp; Reload (Ctrl+S)" Command="{Binding SaveReloadCommand}" ToolTip="Saves the file and reloads the table in Revit, verifying what was loaded. One Undo step in the model." />
                <Button Style="{StaticResource Tool}" Content="Save as…" Command="{Binding SaveAsCommand}" />
                <Button Style="{StaticResource Tool}" Content="Import…" Command="{Binding ImportCommand}" ToolTip="Imports a Revit or pyRevit TXT with a review of new / identical / conflicting keynotes" />
                <Button Style="{StaticResource Tool}" Content="Export ▾" Click="OnMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Export all keynotes…" Command="{Binding ExportAllCommand}" />
                            <MenuItem Header="Export filtered keynotes only (with their parents)…" Command="{Binding ExportFilteredCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource Tool}" Content="Open folder" Command="{Binding OpenFolderCommand}" />
                <Button Style="{StaticResource Tool}" Content="Reload (F5)" Command="{Binding RefreshCommand}" ToolTip="Reads the file, Revit's table and the usage in the model again" />
            </WrapPanel>
            <Border Style="{StaticResource Panel}" Padding="8,4">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap"><Run Text="File: " FontWeight="SemiBold" /><Run Text="{Binding FilePath, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding FileStatus}" TextWrapping="Wrap" Foreground="#23394D" AutomationProperties.Name="File status" />
                    <TextBlock Text="{Binding RevitStatus}" TextWrapping="Wrap" Foreground="#0E7C86" AutomationProperties.Name="Revit status" />
                    <TextBlock Text="{Binding AccessNotes}" Style="{StaticResource Hint}" Visibility="{Binding AccessNotes, Converter={StaticResource TextToVis}}" />
                </StackPanel>
            </Border>
            <Border Background="#FFF2CC" BorderBrush="#E0A800" BorderThickness="1" Padding="8,4" Margin="0,4,0,0"
                    Visibility="{Binding ReadOnlyReason, Converter={StaticResource TextToVis}}">
                <TextBlock Text="{Binding ReadOnlyReason}" TextWrapping="Wrap" />
            </Border>
            <Expander Header="File issues" Margin="0,4,0,0" Visibility="{Binding IssuesText, Converter={StaticResource TextToVis}}">
                <TextBox Text="{Binding IssuesText, Mode=OneWay}" IsReadOnly="True" MaxHeight="120" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            </Expander>
        </StackPanel>

        <!-- Editing: main actions on the left; Revert and the More menu on the right -->
        <DockPanel Grid.Row="2" Margin="12,6,12,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Tool}" Content="Revert" Command="{Binding RevertCommand}" ToolTip="Undo the pending change of this keynote" />
                <Button x:Name="MoreButton" Style="{StaticResource Tool}" Content="More ▾" Click="OnMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Change key…" Command="{Binding RekeyCommand}" ToolTip="Explicit key change: children and model references are updated on Save &amp; Reload" />
                            <MenuItem Header="Delete" InputGestureText="Del" Command="{Binding DeleteCommand}" />
                            <MenuItem Header="Outdent" InputGestureText="Shift+Tab" Command="{Binding OutdentCommand}" />
                            <MenuItem Header="Indent" InputGestureText="Tab" Command="{Binding IndentCommand}" />
                            <Separator />
                            <MenuItem Header="Copy branch" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" />
                            <MenuItem Header="Paste into selection" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" />
                            <MenuItem Header="Copy key" Command="{Binding CopyKeyCommand}" />
                            <MenuItem Header="Copy text" Command="{Binding CopyTextCommand}" />
                            <Separator />
                            <MenuItem Header="UPPERCASE" Command="{Binding TransformCommand}" CommandParameter="upper" />
                            <MenuItem Header="lowercase" Command="{Binding TransformCommand}" CommandParameter="lower" />
                            <MenuItem Header="Title Case" Command="{Binding TransformCommand}" CommandParameter="title" />
                            <MenuItem Header="Sentence case" Command="{Binding TransformCommand}" CommandParameter="sentence" />
                            <MenuItem Header="UPPERCASE entire branch" Command="{Binding TransformCommand}" CommandParameter="upper-branch" />
                            <MenuItem Header="Save text as template…" Command="{Binding SaveTemplateCommand}" />
                            <Separator />
                            <MenuItem Header="Expand all" Command="{Binding ExpandAllCommand}" />
                            <MenuItem Header="Collapse all" Command="{Binding CollapseAllCommand}" />
                            <Separator />
                            <MenuItem Header="Discard all changes…" Command="{Binding DiscardCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <WrapPanel DockPanel.Dock="Left">
                <Button Style="{StaticResource Tool}" Content="New group" Command="{Binding NewGroupCommand}" ToolTip="Top-level keynote (category). E.g. E – ELECTRICAL" />
                <Button Style="{StaticResource Tool}" Content="New subgroup" Command="{Binding NewSubgroupCommand}" ToolTip="Inside the selected row. E.g. E-LTG – LIGHTING" />
                <Button Style="{StaticResource Tool}" Content="New keynote (Ctrl+N)" Command="{Binding NewKeynoteCommand}" ToolTip="Inside the selected group/subgroup" />
                <Button Style="{StaticResource Tool}" Content="Edit (F2)" Command="{Binding EditCommand}" />
                <Button Style="{StaticResource Tool}" Content="Duplicate (Ctrl+D)" Command="{Binding DuplicateCommand}" />
            </WrapPanel>
        </DockPanel>

        <!-- Filters -->
        <WrapPanel Grid.Row="3" Margin="12,2,12,4">
            <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox x:Name="SearchBox" Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" VerticalContentAlignment="Center"
                     AutomationProperties.Name="Search" ToolTip="Key or text (Ctrl+F)" Margin="0,0,10,0" />
            <TextBlock Text="Usage" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="UsageCombo" Width="190" SelectedItem="{Binding UsageFilter}" Margin="0,0,10,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock x:Name="T" Text="All" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding}" Value="WithTags"><Setter TargetName="T" Property="Text" Value="With tags" /></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="WithoutTags"><Setter TargetName="T" Property="Text" Value="Without tags" /></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="InActiveView"><Setter TargetName="T" Property="Text" Value="Visible in active view" /></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="Changed"><Setter TargetName="T" Property="Text" Value="With unsaved changes" /></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="WithIssues"><Setter TargetName="T" Property="Text" Value="With issues" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Source" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="SourceCombo" Width="110" SelectedItem="{Binding SourceFilter}" Margin="0,0,10,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock x:Name="T" Text="Any" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding}" Value="User"><Setter TargetName="T" Property="Text" Value="User" /></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="Element"><Setter TargetName="T" Property="Text" Value="Element" /></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="Material"><Setter TargetName="T" Property="Text" Value="Material" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Regex include" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Width="120" Text="{Binding RegexInclude, UpdateSourceTrigger=PropertyChanged, Delay=400}" Margin="0,0,8,0" ToolTip="Matched against &quot;key TAB text&quot;, case-insensitive" />
            <TextBlock Text="exclude" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Width="120" Text="{Binding RegexExclude, UpdateSourceTrigger=PropertyChanged, Delay=400}" Margin="0,0,8,0" />
            <Button Style="{StaticResource Tool}" Content="This branch" Command="{Binding BranchFilterCommand}" />
            <Button Style="{StaticResource Tool}" Content="Clear filters" Command="{Binding ClearFiltersCommand}" />
            <TextBlock Text="{Binding BranchText}" Foreground="#0E7C86" VerticalAlignment="Center" Margin="4,0" />
            <TextBlock Text="{Binding RegexError}" Foreground="#B00020" VerticalAlignment="Center" Margin="4,0" />
        </WrapPanel>

        <!-- Tree + detail -->
        <Grid Grid.Row="4" Margin="12,0,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="{StaticResource PanelHeader}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Key" FontWeight="SemiBold" Margin="26,3,0,3" />
                        <TextBlock Grid.Column="1" Text="Text" FontWeight="SemiBold" Margin="4,3" />
                        <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold" Margin="4,3" />
                        <TextBlock Grid.Column="3" Text="Usage (this project)" FontWeight="SemiBold" Margin="4,3" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="6,2" />
                    <ListBox x:Name="Tree" ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource KeynoteItem}" BorderThickness="0"
                             SelectionMode="Single" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True" AutomationProperties.Name="Keynotes"
                             PreviewMouseLeftButtonDown="OnTreeMouseDown" PreviewMouseMove="OnTreeMouseMove" Drop="OnTreeDrop" DragOver="OnTreeDragOver">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KeynoteRow}">
                                <Grid Background="Transparent" ToolTip="{Binding StateTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <Border Width="{Binding IndentWidth}" />
                                        <Button Width="20" Height="18" Padding="0" Margin="0" MinHeight="0" Background="Transparent" BorderThickness="0" Focusable="False"
                                                Content="{Binding Glyph}" Click="OnToggle" ToolTip="Expand / collapse" />
                                        <TextBlock x:Name="K" Text="{Binding Key}" VerticalAlignment="Center" Margin="2,0,4,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock x:Name="Tx" Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" ToolTip="{Binding Text}" />
                                    <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center" Foreground="#1F5FBF" FontWeight="SemiBold" Margin="4,0" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <TextBlock Text="⚠ " Foreground="#B00020" VerticalAlignment="Center" ToolTip="{Binding Issue}" Visibility="{Binding HasIssue, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Usage}" VerticalAlignment="Center" Foreground="#23394D" ToolTip="{Binding UsageTip}" Margin="4,0" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                        <Setter TargetName="K" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsContext}" Value="True">
                                        <Setter TargetName="K" Property="Foreground" Value="#8A949C" />
                                        <Setter TargetName="Tx" Property="Foreground" Value="#8A949C" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasIssue}" Value="True">
                                        <Setter TargetName="K" Property="Foreground" Value="#B00020" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding}">
                    <TextBlock Text="Selection" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedRow.Key}" FontSize="15" FontWeight="SemiBold" Foreground="#23394D" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedRow.Text}" TextWrapping="Wrap" Margin="0,2,0,6" />
                    <TextBlock Text="{Binding SelectedRow.Issue}" Foreground="#B00020" TextWrapping="Wrap" Visibility="{Binding SelectedRow.Issue, Converter={StaticResource TextToVis}}" />
                    <TextBlock Text="{Binding SelectedUsageText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="Views with tags (double-click to open and select)" Style="{StaticResource Hint}" />
                    <ListBox x:Name="ViewsList" ItemsSource="{Binding SelectedViews}" MaxHeight="150" Margin="0,2,0,4" MouseDoubleClick="OnViewDoubleClick" />
                    <Button Content="Select tags in Revit" Command="{Binding ShowTagsCommand}" CommandParameter="{Binding SelectedItem, ElementName=ViewsList}" HorizontalAlignment="Left" Margin="0,0,0,10" />

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Click="OnCloseClick" IsCancel="False" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding BusyText}" Foreground="{StaticResource Muted}" Margin="8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="Status" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
