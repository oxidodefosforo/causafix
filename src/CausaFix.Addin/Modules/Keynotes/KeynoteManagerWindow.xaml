<Window x:Class="CausaFix.Addin.Modules.Keynotes.KeynoteManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CausaFix.Keynotes.ViewModels;assembly=CausaFix.Keynotes"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Name="Root"
        Title="CausaFixIt · Keynote Manager" Icon="/CausaFix.Addin;component/Assets/causafixit-32.png"
        Width="1220" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="12" Background="#F7F9FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CausaFix.Addin;component/Shared/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Rows fill the whole width so a click on the text or on the free space selects the row. -->
            <Style x:Key="KeynoteItem" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Key}" />
                <EventSetter Event="GotKeyboardFocus" Handler="OnRowFocus" />
                <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
            </Style>
            <Style x:Key="Tool" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Padding" Value="8,2" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Slate}" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/CausaFix.Addin;component/Assets/causafixit-64.png" Width="28" Height="28" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" AutomationProperties.Name="CausaFixIt logo" />
                    <TextBlock Text="CausaFixIt" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="Keynote Manager" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Table.DocumentTitle}" Foreground="#B9C6D1" Margin="18,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DirtyText}" Foreground="#F2B53A" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- File / Revit state -->
        <StackPanel Grid.Row="1" Margin="12,8,12,2">
            <WrapPanel>
                <Button Style="{StaticResource Tool}" Content="Nuevo archivo…" Command="{Binding NewFileCommand}" ToolTip="Crea una biblioteca vacía (UTF-16 LE) y ofrece vincularla al modelo" />
                <Button Style="{StaticResource Tool}" Content="Abrir…" Command="{Binding OpenFileCommand}" ToolTip="Abre otro archivo de keynotes (TXT)" />
                <Button Style="{StaticResource Tool}" Content="Vincular al modelo" Command="{Binding LinkCommand}" ToolTip="Hace que Revit use este archivo como tabla de keynotes (LoadFrom)" />
                <Button Style="{StaticResource Tool}" Content="Guardar" Command="{Binding SaveCommand}" ToolTip="Escribe el archivo de forma segura (copia previa, comprobación de cambios ajenos). Revit no se recarga." />
                <Button Style="{StaticResource Primary}" Margin="0,0,4,4" Content="Guardar y recargar (Ctrl+S)" Command="{Binding SaveReloadCommand}" ToolTip="Guarda el archivo y recarga la tabla en Revit; verifica lo cargado. Un solo Deshacer en el modelo." />
                <Button Style="{StaticResource Tool}" Content="Guardar como…" Command="{Binding SaveAsCommand}" />
                <Button Style="{StaticResource Tool}" Content="Importar…" Command="{Binding ImportCommand}" ToolTip="Importa un TXT de Revit o de pyRevit con revisión de nuevas / iguales / en conflicto" />
                <Button Style="{StaticResource Tool}" Content="Exportar ▾" Click="OnMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Exportar todas las notas…" Command="{Binding ExportAllCommand}" />
                            <MenuItem Header="Exportar solo las filtradas (con sus padres)…" Command="{Binding ExportFilteredCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource Tool}" Content="Abrir carpeta" Command="{Binding OpenFolderCommand}" />
                <Button Style="{StaticResource Tool}" Content="Releer (F5)" Command="{Binding RefreshCommand}" ToolTip="Vuelve a leer el archivo, la tabla de Revit y el uso en el modelo" />
            </WrapPanel>
            <Border Style="{StaticResource Panel}" Padding="8,4">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap"><Run Text="Archivo: " FontWeight="SemiBold" /><Run Text="{Binding FilePath, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding FileStatus}" TextWrapping="Wrap" Foreground="#23394D" AutomationProperties.Name="Estado del archivo" />
                    <TextBlock Text="{Binding RevitStatus}" TextWrapping="Wrap" Foreground="#0E7C86" AutomationProperties.Name="Estado en Revit" />
                    <TextBlock Text="{Binding AccessNotes}" Style="{StaticResource Hint}" Visibility="{Binding AccessNotes, Converter={StaticResource TextToVis}}" />
                </StackPanel>
            </Border>
            <Border Background="#FFF2CC" BorderBrush="#E0A800" BorderThickness="1" Padding="8,4" Margin="0,4,0,0"
                    Visibility="{Binding ReadOnlyReason, Converter={StaticResource TextToVis}}">
                <TextBlock Text="{Binding ReadOnlyReason}" TextWrapping="Wrap" />
            </Border>
            <Expander Header="Problemas del archivo" Margin="0,4,0,0" Visibility="{Binding IssuesText, Converter={StaticResource TextToVis}}">
                <TextBox Text="{Binding IssuesText, Mode=OneWay}" IsReadOnly="True" MaxHeight="120" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            </Expander>
        </StackPanel>

        <!-- Editing -->
        <WrapPanel Grid.Row="2" Margin="12,6,12,0">
            <Button Style="{StaticResource Tool}" Content="Nuevo grupo" Command="{Binding NewGroupCommand}" ToolTip="Nota de primer nivel (categoría). Ej.: E – ELECTRICAL" />
            <Button Style="{StaticResource Tool}" Content="Nuevo subgrupo" Command="{Binding NewSubgroupCommand}" ToolTip="Dentro de la fila seleccionada. Ej.: E-LTG – LIGHTING" />
            <Button Style="{StaticResource Tool}" Content="Nueva nota (Ctrl+N)" Command="{Binding NewKeynoteCommand}" ToolTip="Dentro del grupo/subgrupo seleccionado" />
            <Button Style="{StaticResource Tool}" Content="Editar (F2)" Command="{Binding EditCommand}" />
            <Button Style="{StaticResource Tool}" Content="Duplicar (Ctrl+D)" Command="{Binding DuplicateCommand}" />
            <Button Style="{StaticResource Tool}" Content="Cambiar clave…" Command="{Binding RekeyCommand}" ToolTip="Cambio explícito de clave: las hijas y las referencias del modelo se actualizan al guardar y recargar" />
            <Button Style="{StaticResource Tool}" Content="Eliminar (Supr)" Command="{Binding DeleteCommand}" />
            <Button Style="{StaticResource Tool}" Content="⇤ Subir nivel (Mayús+Tab)" Command="{Binding OutdentCommand}" />
            <Button Style="{StaticResource Tool}" Content="Bajar nivel ⇥ (Tab)" Command="{Binding IndentCommand}" />
            <Button Style="{StaticResource Tool}" Content="Revertir" Command="{Binding RevertCommand}" ToolTip="Deshace el cambio pendiente de esta nota" />
            <Button Style="{StaticResource Tool}" Content="Más ▾" Click="OnMenu">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copiar rama (Ctrl+C)" Command="{Binding CopyCommand}" />
                        <MenuItem Header="Pegar dentro de la selección (Ctrl+V)" Command="{Binding PasteCommand}" />
                        <MenuItem Header="Copiar clave" Command="{Binding CopyKeyCommand}" />
                        <MenuItem Header="Copiar texto" Command="{Binding CopyTextCommand}" />
                        <Separator />
                        <MenuItem Header="MAYÚSCULAS" Command="{Binding TransformCommand}" CommandParameter="upper" />
                        <MenuItem Header="minúsculas" Command="{Binding TransformCommand}" CommandParameter="lower" />
                        <MenuItem Header="Tipo Título" Command="{Binding TransformCommand}" CommandParameter="title" />
                        <MenuItem Header="Tipo oración" Command="{Binding TransformCommand}" CommandParameter="sentence" />
                        <MenuItem Header="MAYÚSCULAS en toda la rama" Command="{Binding TransformCommand}" CommandParameter="upper-branch" />
                        <MenuItem Header="Guardar texto como plantilla…" Command="{Binding SaveTemplateCommand}" />
                        <Separator />
                        <MenuItem Header="Expandir todo" Command="{Binding ExpandAllCommand}" />
                        <MenuItem Header="Contraer todo" Command="{Binding CollapseAllCommand}" />
                        <Separator />
                        <MenuItem Header="Descartar todos los cambios…" Command="{Binding DiscardCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </WrapPanel>

        <!-- Filters -->
        <WrapPanel Grid.Row="3" Margin="12,2,12,4">
            <TextBlock Text="Buscar" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox x:Name="SearchBox" Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" VerticalContentAlignment="Center"
                     AutomationProperties.Name="Buscar" ToolTip="Clave o texto (Ctrl+F)" Margin="0,0,10,0" />
            <TextBlock Text="Uso" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="UsageCombo" Width="190" SelectedItem="{Binding UsageFilter}" Margin="0,0,10,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock x:Name="T" Text="Todas" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding}" Value="WithTags"><Setter TargetName="T" Property="Text" Value="Con etiquetas" /></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="WithoutTags"><Setter TargetName="T" Property="Text" Value="Sin etiquetas" /></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="InActiveView"><Setter TargetName="T" Property="Text" Value="Visibles en la vista activa" /></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="Changed"><Setter TargetName="T" Property="Text" Value="Con cambios sin guardar" /></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="WithIssues"><Setter TargetName="T" Property="Text" Value="Con problemas" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Origen" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="SourceCombo" Width="110" SelectedItem="{Binding SourceFilter}" Margin="0,0,10,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock x:Name="T" Text="Cualquiera" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding}" Value="User"><Setter TargetName="T" Property="Text" Value="Usuario" /></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="Element"><Setter TargetName="T" Property="Text" Value="Elemento" /></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="Material"><Setter TargetName="T" Property="Text" Value="Material" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Regex incluir" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Width="120" Text="{Binding RegexInclude, UpdateSourceTrigger=PropertyChanged, Delay=400}" Margin="0,0,8,0" ToolTip="Se aplica a «clave TAB texto»; sin distinguir mayúsculas" />
            <TextBlock Text="excluir" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Width="120" Text="{Binding RegexExclude, UpdateSourceTrigger=PropertyChanged, Delay=400}" Margin="0,0,8,0" />
            <Button Style="{StaticResource Tool}" Content="Solo esta rama" Command="{Binding BranchFilterCommand}" />
            <Button Style="{StaticResource Tool}" Content="Quitar filtros" Command="{Binding ClearFiltersCommand}" />
            <TextBlock Text="{Binding BranchText}" Foreground="#0E7C86" VerticalAlignment="Center" Margin="4,0" />
            <TextBlock Text="{Binding RegexError}" Foreground="#B00020" VerticalAlignment="Center" Margin="4,0" />
        </WrapPanel>

        <!-- Tree + detail -->
        <Grid Grid.Row="4" Margin="12,0,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="{StaticResource PanelHeader}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Clave" FontWeight="SemiBold" Margin="26,3,0,3" />
                        <TextBlock Grid.Column="1" Text="Texto" FontWeight="SemiBold" Margin="4,3" />
                        <TextBlock Grid.Column="2" Text="Estado" FontWeight="SemiBold" Margin="4,3" />
                        <TextBlock Grid.Column="3" Text="Uso (este proyecto)" FontWeight="SemiBold" Margin="4,3" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="6,2" />
                    <ListBox x:Name="Tree" ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource KeynoteItem}" BorderThickness="0"
                             SelectionMode="Single" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True" AutomationProperties.Name="Keynotes"
                             PreviewMouseLeftButtonDown="OnTreeMouseDown" PreviewMouseMove="OnTreeMouseMove" Drop="OnTreeDrop" DragOver="OnTreeDragOver">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KeynoteRow}">
                                <Grid Background="Transparent" ToolTip="{Binding StateTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <Border Width="{Binding IndentWidth}" />
                                        <Button Width="20" Height="18" Padding="0" Margin="0" MinHeight="0" Background="Transparent" BorderThickness="0" Focusable="False"
                                                Content="{Binding Glyph}" Click="OnToggle" ToolTip="Expandir / contraer" />
                                        <TextBlock x:Name="K" Text="{Binding Key}" VerticalAlignment="Center" Margin="2,0,4,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock x:Name="Tx" Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" ToolTip="{Binding Text}" />
                                    <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center" Foreground="#1F5FBF" FontWeight="SemiBold" Margin="4,0" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <TextBlock Text="⚠ " Foreground="#B00020" VerticalAlignment="Center" ToolTip="{Binding Issue}" Visibility="{Binding HasIssue, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Usage}" VerticalAlignment="Center" Foreground="#23394D" ToolTip="{Binding UsageTip}" Margin="4,0" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                        <Setter TargetName="K" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsContext}" Value="True">
                                        <Setter TargetName="K" Property="Foreground" Value="#8A949C" />
                                        <Setter TargetName="Tx" Property="Foreground" Value="#8A949C" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasIssue}" Value="True">
                                        <Setter TargetName="K" Property="Foreground" Value="#B00020" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding}">
                    <TextBlock Text="Selección" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedRow.Key}" FontSize="15" FontWeight="SemiBold" Foreground="#23394D" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedRow.Text}" TextWrapping="Wrap" Margin="0,2,0,6" />
                    <TextBlock Text="{Binding SelectedRow.Issue}" Foreground="#B00020" TextWrapping="Wrap" Visibility="{Binding SelectedRow.Issue, Converter={StaticResource TextToVis}}" />
                    <TextBlock Text="{Binding SelectedUsageText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="Vistas con etiquetas (doble clic para abrir y seleccionar)" Style="{StaticResource Hint}" />
                    <ListBox x:Name="ViewsList" ItemsSource="{Binding SelectedViews}" MaxHeight="150" Margin="0,2,0,4" MouseDoubleClick="OnViewDoubleClick" />
                    <Button Content="Seleccionar etiquetas en Revit" Command="{Binding ShowTagsCommand}" CommandParameter="{Binding SelectedItem, ElementName=ViewsList}" HorizontalAlignment="Left" Margin="0,0,0,10" />

                    <TextBlock Text="Colocar en la vista activa" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" Text="Usa los comandos nativos de Revit. La clave debe estar guardada y recargada; si no, se ofrece hacerlo." />
                    <WrapPanel Margin="0,4,0,4">
                        <Button Content="Nota de usuario" Command="{Binding PlaceCommand}" CommandParameter="user" Style="{StaticResource Primary}" Margin="0,0,4,4"
                                ToolTip="Coloca etiquetas User Keynote con esta clave (por defecto)" />
                        <Button Content="De elemento" Command="{Binding PlaceCommand}" CommandParameter="element" Margin="0,0,4,4"
                                ToolTip="Element Keynote: la clave va al tipo del elemento etiquetado (solo si está vacía; nunca se sobrescribe otra clave)" />
                        <Button Content="De material" Command="{Binding PlaceCommand}" CommandParameter="material" Margin="0,0,4,4"
                                ToolTip="Material Keynote: Revit pide la clave del material en su diálogo (la API no permite fijarla aquí)" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Atajos: F2 editar · Ctrl+N nueva nota · Ctrl+D duplicar · Ctrl+C / Ctrl+V copiar y pegar rama · Supr eliminar · Tab / Mayús+Tab nivel · Ctrl+S guardar y recargar · F5 releer · Ctrl+F buscar. Arrastra una fila sobre otra para moverla dentro (las claves no cambian); suéltala en el espacio libre para llevarla al primer nivel." />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="El uso cuenta solo este proyecto. Otros proyectos que compartan el archivo no se ven desde aquí: cambiar o borrar una clave puede afectarles." />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cerrar" Click="OnCloseClick" IsCancel="False" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding BusyText}" Foreground="{StaticResource Muted}" Margin="8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="Estado" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
