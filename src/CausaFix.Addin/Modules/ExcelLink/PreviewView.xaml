<UserControl x:Class="CausaFix.Addin.Modules.ExcelLink.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CausaFix.Addin;component/Shared/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="2,0,2,4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Sheet" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox DockPanel.Dock="Left" Width="260" ItemsSource="{Binding Preview.Sheets}" SelectedItem="{Binding Preview.Current}" DisplayMemberPath="Title" />
            <TextBox DockPanel.Dock="Left" Width="200" Style="{StaticResource Search}" Text="{Binding Preview.Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
            <RadioButton DockPanel.Dock="Left" Content="All rows" IsChecked="{Binding Preview.ShowAll}" GroupName="rowFilter" VerticalAlignment="Center" Margin="8,0,8,0" />
            <RadioButton DockPanel.Dock="Left" Content="Edited" IsChecked="{Binding Preview.ShowEdited}" GroupName="rowFilter" VerticalAlignment="Center" Margin="0,0,8,0" />
            <RadioButton DockPanel.Dock="Left" Content="Invalid" IsChecked="{Binding Preview.ShowInvalid}" GroupName="rowFilter" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Preview.Summary}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
            <Button Content="Set value…" Click="OnSetValue" ToolTip="Type one value for all selected editable cells" />
            <Button Content="Clear value" Click="OnClearValue" ToolTip="Mark selected cells to be erased (an empty cell never clears a value)" />
            <Button Content="Revert selected" Click="OnRevertSelected" />
            <Button Content="Revert all" Command="{Binding Preview.RevertAllCommand}" />
            <Border Width="1" Background="{StaticResource Line}" Margin="6,2" />
            <Button Content="Copy" Click="OnCopy" ToolTip="Ctrl+C" />
            <Button Content="Paste" Click="OnPaste" ToolTip="Ctrl+V – tab-separated ranges from Excel" />
            <Border Width="1" Background="{StaticResource Line}" Margin="6,2" />
            <Button Content="Select in Revit" Click="OnSelectInRevit" />
            <Button Content="Zoom to" Click="OnShowInRevit" />
            <Button Content="Isolate (temporary)" Click="OnIsolate" ToolTip="Temporary Hide/Isolate in the active view – never permanent" />
            <Button Content="Reset isolate" Command="{Binding ResetIsolateCommand}" />
            <Border Width="1" Background="{StaticResource Line}" Margin="6,2" />
            <Button Content="Reload" Command="{Binding ReloadPreviewCommand}" ToolTip="Re-read the values from Revit" />
            <Button Content="Apply Changes…" Command="{Binding ApplyPreviewCommand}" Style="{StaticResource Primary}"
                    ToolTip="Compare pending edits with the model and review them before writing" />
        </WrapPanel>

        <StackPanel Grid.Row="2" Margin="2,0,2,4">
            <TextBlock Text="{Binding Preview.Current.Notes}" Style="{StaticResource Hint}" Visibility="{Binding Preview.Current.Notes, Converter={StaticResource TextToVis}}" />
            <TextBlock Text="{Binding Preview.Status}" Foreground="#8A5A00" TextWrapping="Wrap" Visibility="{Binding Preview.Status, Converter={StaticResource TextToVis}}" />
            <TextBlock Text="Editing prepares changes only. Nothing is written to Revit until you press Apply Changes and confirm the review."
                       Style="{StaticResource Hint}" Visibility="{Binding Preview.HasData, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Preview.Summary}" Visibility="{Binding Preview.HasData, Converter={StaticResource InverseBoolToVis}}" Margin="0,20" HorizontalAlignment="Center" />
        </StackPanel>

        <DataGrid x:Name="Table" Grid.Row="3"
                  ItemsSource="{Binding Preview.VisibleRows}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                  CanUserResizeColumns="True" CanUserSortColumns="True"
                  SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  HeadersVisibility="All" RowHeaderWidth="18" GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#E3E7EA" VerticalGridLinesBrush="#E3E7EA"
                  ClipboardCopyMode="None" RowHeight="22"
                  BeginningEdit="OnBeginningEdit" CellEditEnding="OnCellEditEnding"
                  PreviewKeyDown="OnGridKeyDown">
            <DataGrid.RowHeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="●" Foreground="#2F6FEB" FontSize="9" HorizontalAlignment="Center"
                               Visibility="{Binding DataContext.HasEdits, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource BoolToVis}}" />
                </DataTemplate>
            </DataGrid.RowHeaderTemplate>
        </DataGrid>
    </Grid>
</UserControl>
