<Window x:Class="CausaFix.Addin.Modules.ExcelLink.ExcelLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CausaFix.Addin.Modules.ExcelLink"
        Title="CausaFixIt · Excel Link" Icon="/CausaFix.Addin;component/Assets/causafixit-32.png"
        Width="1180" Height="760" MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="12"
        Background="#F7F9FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CausaFix.Addin;component/Shared/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: brand, model, profiles -->
        <Border Grid.Row="0" Background="{StaticResource Slate}" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- CausaFixIt brand: approved symbol + wordmark -->
                    <Image Source="/CausaFix.Addin;component/Assets/causafixit-64.png" Width="28" Height="28" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" AutomationProperties.Name="CausaFixIt logo" />
                    <TextBlock Text="CausaFixIt" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="Excel Link" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DocumentTitle}" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DocumentInfo}" Foreground="#B9C6D1" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Profile" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="190" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" ToolTip="Saved selections (categories, parameters, order, options)" />
                    <Button Content="Load" Command="{Binding LoadProfileCommand}" ToolTip="Apply the selected profile" />
                    <Button Content="Save" Command="{Binding SaveProfileCommand}" ToolTip="Save the current tab selection into the selected profile" />
                    <Button x:Name="ProfileMenuButton" Content="More ▾" Click="OnProfileMenu" ToolTip="Profile actions">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Save as new profile…" Command="{Binding SaveProfileAsCommand}" />
                                <MenuItem Header="Duplicate…" Command="{Binding DuplicateProfileCommand}" />
                                <MenuItem Header="Rename…" Command="{Binding RenameProfileCommand}" />
                                <MenuItem Header="Delete" Command="{Binding DeleteProfileCommand}" />
                                <Separator />
                                <MenuItem Header="Import profile…" Command="{Binding ImportProfileCommand}" />
                                <MenuItem Header="Export profile…" Command="{Binding ExportProfileCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="ToolsMenuButton" Content="⚙ ▾" Click="OnToolsMenu" Margin="12,0,0,0" ToolTip="Settings, logs, reports">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Settings…" Command="{Binding SettingsCommand}" />
                                <MenuItem Header="Open reports folder" Command="{Binding OpenReportsCommand}" />
                                <MenuItem Header="Open logs folder" Command="{Binding OpenLogsCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Margin="8,8,8,0" SelectedIndex="{Binding SelectedTab}" Padding="6">
            <TabItem Header="Model Categories">
                <local:CategoryTabView DataContext="{Binding ModelTab}" />
            </TabItem>
            <TabItem Header="Annotation Categories">
                <local:CategoryTabView DataContext="{Binding AnnotationTab}" />
            </TabItem>
            <TabItem Header="Elements">
                <local:CategoryTabView DataContext="{Binding ElementsTab}" />
            </TabItem>
            <TabItem Header="Schedules">
                <local:SchedulesTabView DataContext="{Binding SchedulesTab}" />
            </TabItem>
            <TabItem Header="Spatial">
                <local:CategoryTabView DataContext="{Binding SpatialTab}" />
            </TabItem>
            <TabItem Header="Preview / Edit">
                <local:PreviewView x:Name="PreviewPane" />
            </TabItem>
        </TabControl>

        <!-- Footer: counters, progress, main actions -->
        <Border Grid.Row="2" Margin="8,6,8,6">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Reset Selection" Command="{Binding ResetSelectionCommand}" ToolTip="Uncheck categories and clear selected parameters in this tab" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" ToolTip="Re-read the model (keeps selections by key)" />
                    <Button x:Name="MoreButton" Content="More ▾" Click="OnMoreMenu" ToolTip="Project Information, inventories">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Project Information (editable, opens in Preview/Edit)" Command="{Binding InventoryCommand}" CommandParameter="ProjectInformation" />
                                <Separator />
                                <MenuItem Header="Export family inventory (read-only)…" Command="{Binding InventoryCommand}" CommandParameter="Families" />
                                <MenuItem Header="Export Object Styles (read-only)…" Command="{Binding InventoryCommand}" CommandParameter="ObjectStyles" />
                                <MenuItem Header="Export Line Styles (read-only)…" Command="{Binding InventoryCommand}" CommandParameter="LineStyles" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Preview / Edit" Command="{Binding PreviewCommand}" Margin="12,0,3,0" ToolTip="Load the selection into an editable table" />
                    <Button Content="Import…" Command="{Binding ImportCommand}" ToolTip="Read a CausaFixIt workbook, compare with the model and review changes" />
                    <Button Content="Export…" Command="{Binding ExportCommand}" Style="{StaticResource Primary}" ToolTip="Write the selection to an .xlsx file" />
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Counters}" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Width="220" Height="10" Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding Progress}"
                                     IsIndeterminate="{Binding ProgressIndeterminate}" />
                        <TextBlock Text="{Binding BusyText}" Margin="8,0" Foreground="{StaticResource Muted}" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="8,0" MinHeight="20" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="3" Background="{StaticResource PanelHeader}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,3">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
        </Border>
    </Grid>
</Window>
